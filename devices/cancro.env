# Xiaomi Mi 4 / Mi 3 (cancro) — Qualcomm MSM8974PRO (Snapdragon 801)
#
# 32-bit device (armhf): separate kernel source and ubuntu-base tarball from
# the msm8916 package, so it builds as its own extlinux package (never mix
# into the msm8916 multi-device invocation).
DEVICE_CODENAME="cancro"
DEVICE_NAME="Xiaomi Mi 4 (cancro)"
SOC="msm8974"
ARCH="armhf"

# Kernel: bzy-080408/linux-msm8974 (fork of msm8974-mainline/linux),
# branch cancro-klipper — v6.15.11 + cancro dts + cancro_klipper_defconfig.
KERNEL_SUBMODULE="kernels/msm8974"
KERNEL_DEFCONFIG="cancro_klipper_defconfig"
# Three panel/touch variants (RMI4 @0x70 / @0x71, Atmel mxt640t); all are
# shipped under /dtbs/ and lk2nd picks one via fdtdir matching.
KERNEL_DTB="qcom/qcom-msm8974pro-xiaomi-cancro-rmi4-70.dtb qcom/qcom-msm8974pro-xiaomi-cancro-rmi4-71.dtb qcom/qcom-msm8974pro-xiaomi-cancro-mxt-640t.dtb"

# Android boot image layout, from the historical pmaports
# device-xiaomi-cancro deviceinfo (package since removed from pmaports).
# Note: stock mkbootimg packing would also need the qcdt dt.img
# (bootimg_qcdt=true); the extlinux/lk2nd route we ship does not.
BOOTIMG_BASE="0x00000000"
BOOTIMG_KERNEL_OFFSET="0x00008000"
BOOTIMG_RAMDISK_OFFSET="0x02000000"
BOOTIMG_SECOND_OFFSET="0x00f00000"
BOOTIMG_TAGS_OFFSET="0x01e00000"
BOOTIMG_PAGESIZE="2048"

# Root filesystem: 32-bit ubuntu-base. The cancro_klipper_defconfig enables
# RD_GZIP (RD_ZSTD unverified on this kernel) — gzip the initramfs.
UBUNTU_BASE_URL="https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.3-base-armhf.tar.gz"
INITRD_COMPRESS="gzip"
ROOTFS_UUID="93afcbbe-875f-49b0-83da-ee8193f20ca5"
ROOTFS_SIZE_MB="2048"
KERNEL_CMDLINE="console=ttyMSM0,115200 console=tty0 root=UUID=${ROOTFS_UUID} rw rootwait"

# lk2nd secondary bootloader (official prebuilt; lk2nd-msm8974 covers cancro,
# see lk2nd Documentation/devices.md).
LK2ND_VERSION="23.1"
LK2ND_URL="https://github.com/msm8916-mainline/lk2nd/releases/download/${LK2ND_VERSION}/lk2nd-${SOC}.img"
LK2ND_SHA256="dee885042b96a774889ca1498d20802bd6abd51684a7bbaaedde39d104b6c80c"

# System identity
HOSTNAME="umeko-cancro"
DEFAULT_USER="umeko"
DEFAULT_PASSWORD="1234"
SERIAL_CONSOLES="ttyMSM0"

# WIP: no armhf webssh binary yet — WEBSSH_URL stays unset and
# autowebssh.service is not enabled in the post-assemble hook.
