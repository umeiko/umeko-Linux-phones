# cancro kernel config fragment — merged on top of cancro_klipper_defconfig
# (kernels/msm8974 ships it as a full generated .config, already carrying
# USB configfs + CAN + chipidea UDC bits for the Klipper use case).

# Issue #36 parity: the upstream defconfig also builds in g_serial, which
# grabs the UDC at boot and blocks OTG role switching. The configfs gadget
# (usb-gadget.service, config/rootfs overlay) assembles acm+ncm at boot
# instead — keep the built-in one OFF.
# CONFIG_USB_G_SERIAL is not set

# The upstream defconfig carries a leftover localversion/hostname from the
# tree it was generated in; neutralize both.
CONFIG_LOCALVERSION=""
CONFIG_DEFAULT_HOSTNAME=""

# Reproducible kernelrelease: never append SCM suffixes.
# CONFIG_LOCALVERSION_AUTO is not set

# On-screen console (simplefb from lk2nd).
CONFIG_FRAMEBUFFER_CONSOLE=y
