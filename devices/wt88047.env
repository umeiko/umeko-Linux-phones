# Xiaomi Redmi 2 (wt88047) — Qualcomm MSM8916
DEVICE_CODENAME="wt88047"
DEVICE_NAME="Xiaomi Redmi 2"
SOC="msm8916"
ARCH="arm64"

# Kernel: git submodule pinned to msm8916-mainline/linux @ v6.12.1-msm8916
KERNEL_SUBMODULE="kernels/msm8916"
KERNEL_DEFCONFIG="msm8916_defconfig"
KERNEL_DTB="qcom/msm8916-wingtech-wt88047.dtb"

# Android boot image layout. Uses the lk2nd/postmarketOS convention
# (same as pmaports device/community/device-xiaomi-wt88047/deviceinfo).
BOOTIMG_BASE="0x80000000"
BOOTIMG_KERNEL_OFFSET="0x00080000"
BOOTIMG_RAMDISK_OFFSET="0x02000000"
BOOTIMG_SECOND_OFFSET="0x00f00000"
BOOTIMG_TAGS_OFFSET="0x01e00000"
BOOTIMG_PAGESIZE="2048"

# Root filesystem. Fixed ext4 UUID keeps the kernel cmdline reproducible
# (same UUID as the legacy KlipperPhonesLinux images).
ROOTFS_UUID="93afcbbe-875f-49b0-83da-ee8193f20ca5"
ROOTFS_SIZE_MB="2048"
# SDHCI/EXT4/DEVTMPFS are built-in (=y) in msm8916_defconfig, so we boot
# without an initramfs and mount the rootfs directly by UUID.
KERNEL_CMDLINE="earlycon console=ttyMSM0,115200 console=tty0 root=UUID=${ROOTFS_UUID} rw rootwait"

# lk2nd secondary bootloader (official prebuilt, per-SoC image covers wt88047).
LK2ND_VERSION="23.1"
LK2ND_URL="https://github.com/msm8916-mainline/lk2nd/releases/download/${LK2ND_VERSION}/lk2nd-${SOC}.img"
LK2ND_SHA256="8f5f788b45b96447517ff121f20841e6bfc95a5d7c4b48fdedb855d90f593144"

# System identity
HOSTNAME="umeko-wt88047"
DEFAULT_USER="umeko"
DEFAULT_PASSWORD="1234"
# Serial consoles with a classic getty (UART). ttyGS0 is NOT listed here:
# the USB gadget serial console gets a passwordless autologin console from
# the autottyGS0 service instead (see config/rootfs, the shared overlay).
SERIAL_CONSOLES="ttyMSM0"

# webssh arm64 binary for the autowebssh service (web UI ssh on port 8888).
# Downloaded and checksum-verified at build time by assemble.sh.
WEBSSH_URL="https://gitee.com/meiziyang2023/umeko-env-init/raw/a7454f0770617d8b766be88483218699fc93bd3b/webssh_linux_arm64"
WEBSSH_SHA256="57aba680b5528f2d3a0b6cdba7c5e9a53c95eaf809c8203ba496b3bca14102c6"
