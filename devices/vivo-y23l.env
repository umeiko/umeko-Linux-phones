# Vivo Y23L / Y623 / Y923 (pd1419) — Qualcomm MSM8916
#
# NOTE: this is a "quirky" vivo CDP device (stock aboot is 32-bit), so the
# prebuilt lk2nd.img does NOT work on it — it needs lk1st with a panel-specific
# LK2ND_DISPLAY plus replaced tz/hyp firmware (see docs/extlinux.md). The OS
# side (kernel dtb + rootfs) is shared with wt88047 in the combined extlinux
# package; only the bootloader step differs.
DEVICE_CODENAME="vivo-y23l"
DEVICE_NAME="Vivo Y23L"
SOC="msm8916"
ARCH="arm64"

# Kernel: same submodule as wt88047; dtbs come from the device patch series
# in devices/vivo-y23l/kernel-patches/ (0001 adds both pd1419 and pd1304).
# Second entry is the vivo Y13L (pd1304) — same vivo CDP family, shares this
# rootfs; lk2nd picks the right dtb from fdtdir at boot.
KERNEL_SUBMODULE="kernels/msm8916"
KERNEL_DEFCONFIG="msm8916_defconfig"
KERNEL_DTB="qcom/msm8916-vivo-pd1419.dtb qcom/msm8916-vivo-pd1304.dtb"

# Same boot image layout values as wt88047 (unused by the extlinux packer,
# kept for schema consistency).
BOOTIMG_BASE="0x80000000"
BOOTIMG_KERNEL_OFFSET="0x00080000"
BOOTIMG_RAMDISK_OFFSET="0x02000000"
BOOTIMG_SECOND_OFFSET="0x00f00000"
BOOTIMG_TAGS_OFFSET="0x01e00000"
BOOTIMG_PAGESIZE="2048"

# Shared rootfs: must match wt88047.env exactly (one rootfs serves both).
ROOTFS_UUID="93afcbbe-875f-49b0-83da-ee8193f20ca5"
ROOTFS_SIZE_MB="2048"
KERNEL_CMDLINE="earlycon console=ttyMSM0,115200 console=tty0 root=UUID=${ROOTFS_UUID} rw rootwait"

# Bootloader: prebuilt lk2nd (valid for wt88047 only, see NOTE above).
LK2ND_VERSION="23.1"
LK2ND_URL="https://github.com/msm8916-mainline/lk2nd/releases/download/${LK2ND_VERSION}/lk2nd-${SOC}.img"
LK2ND_SHA256="8f5f788b45b96447517ff121f20841e6bfc95a5d7c4b48fdedb855d90f593144"

# System identity (used when building a y23L-only rootfs; the combined
# package takes these from the first env on the command line).
HOSTNAME="umeko-y23l"
DEFAULT_USER="umeko"
DEFAULT_PASSWORD="1234"
SERIAL_CONSOLES="ttyMSM0"

# Same webssh service as wt88047.
WEBSSH_URL="https://gitee.com/meiziyang2023/umeko-env-init/raw/a7454f0770617d8b766be88483218699fc93bd3b/webssh_linux_arm64"
WEBSSH_SHA256="57aba680b5528f2d3a0b6cdba7c5e9a53c95eaf809c8203ba496b3bca14102c6"
