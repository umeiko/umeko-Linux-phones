# Global build configuration (device-independent).
# Device-specific values live in devices/<codename>.env.

# Ubuntu base rootfs. Pin the point release; checksum is verified against the
# official SHA256SUMS at build time. Default is arm64; 32-bit devices set
# UBUNTU_BASE_URL in their device env (device env is sourced before this file,
# so the :- default yields to it).
UBUNTU_BASE_URL="${UBUNTU_BASE_URL:-https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.3-base-arm64.tar.gz}"
UBUNTU_BASE_SHA256SUMS_URL="https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/SHA256SUMS"

# Packages installed into the minimal rootfs (apt, --no-install-recommends).
# initramfs-tools + zstd: an initramfs is REQUIRED for root=UUID= (the kernel
# cannot resolve filesystem UUIDs by itself; blkid/udev in the initramfs do).
ROOTFS_PACKAGES="locales tzdata sudo openssh-server network-manager kmod usbutils iputils-ping net-tools htop nano ca-certificates initramfs-tools zstd"

TIMEZONE="Asia/Shanghai"
LOCALE="en_US.UTF-8"

# extlinux bootfs (pack_extlinux.sh) is created with this fixed ext2 UUID so
# devices can mount it at /boot via fstab (see vivo-y23l post-assemble hook).
BOOTFS_UUID="7e8e201c-5797-40b1-b8fb-cab6eb96226c"

# initramfs compression (written to initramfs-tools conf.d by assemble.sh).
# zstd for arm64 devices; 32-bit kernels may lack CONFIG_RD_ZSTD — those set
# INITRD_COMPRESS="gzip" in their device env.
INITRD_COMPRESS="${INITRD_COMPRESS:-zstd}"

# buffyboard touchscreen keyboard for the console (built from source inside
# the chroot, pinned tag for reproducibility). Off by default — it is slow to
# compile under qemu; opt in with BUFFYBOARD=1.
BUFFYBOARD="${BUFFYBOARD:-0}"
BUFFYBOARD_TAG="3.5.1"
